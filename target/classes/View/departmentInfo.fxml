<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controller.departmentInfoController"
            prefHeight="500.0" prefWidth="700.0"
            style="-fx-background-color: linear-gradient(to bottom, #000000, #001f3f);">

    <!-- Header -->
    <Label text="Department Information"
           layoutX="240.0" layoutY="30.0"
           style="-fx-text-fill: #a9a9a9; -fx-font-size: 22px; -fx-font-weight: bold;" />

    <!-- Search Section -->
    <HBox layoutX="150.0" layoutY="90.0" spacing="10.0">
        <TextField fx:id="txtDepartmentId" promptText="Department ID"
                   prefWidth="200.0"
                   style="-fx-background-color: #1a1a1a;
                          -fx-text-fill: #d3d3d3;
                          -fx-background-radius: 10;" />
        <Button fx:id="btnSearch" text="Search"
                style="-fx-background-color: #1a1a1a;
                       -fx-text-fill: #d3d3d3;
                       -fx-background-radius: 30;
                       -fx-border-radius: 30;
                       -fx-border-color: #a9a9a9;
                       -fx-border-width: 1;" />
    </HBox>

    <!-- Display Section -->
    <VBox layoutX="150.0" layoutY="150.0" spacing="10.0" prefWidth="400.0">
        <TextField fx:id="txtDepartmentName" promptText="Department Name"
                   editable="false"
                   style="-fx-background-color: #1a1a1a;
                          -fx-text-fill: #d3d3d3;
                          -fx-background-radius: 10;" />
        <TextField fx:id="txtManager" promptText="Manager"
                   editable="false"
                   style="-fx-background-color: #1a1a1a;
                          -fx-text-fill: #d3d3d3;
                          -fx-background-radius: 10;" />
        <TextField fx:id="txtLocation" promptText="Location"
                   editable="false"
                   style="-fx-background-color: #1a1a1a;
                          -fx-text-fill: #d3d3d3;
                          -fx-background-radius: 10;" />
        <TextField fx:id="txtEmployeeCount" promptText="Employee Count"
                   editable="false"
                   style="-fx-background-color: #1a1a1a;
                          -fx-text-fill: #d3d3d3;
                          -fx-background-radius: 10;" />
    </VBox>

</AnchorPane>
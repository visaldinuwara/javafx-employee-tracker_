<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controller.dashBoardController"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: #2b2b2b;"> <!-- Dark background -->

    <!-- Header Label -->
    <Label text="Samsung Employee Management System"
           layoutX="150.0" layoutY="30.0"
           style="-fx-text-fill: white; -fx-font-size: 18px;" />

    <!-- Dashboard Buttons -->
    <VBox layoutX="200.0" layoutY="80.0" spacing="10.0">
        <Button fx:id="btnAddEmployee" text="Add Employee"
                style="-fx-background-color: #4a90e2; -fx-text-fill: white;" />
        <Button fx:id="btnUpdateEmployee" text="Update Employee"
                style="-fx-background-color: #4a90e2; -fx-text-fill: white;" />
        <Button fx:id="btnDeleteEmployee" text="Delete Employee"
                style="-fx-background-color: #4a90e2; -fx-text-fill: white;" />
        <Button fx:id="btnViewEmployee" text="View/Search Employee"
                style="-fx-background-color: #4a90e2; -fx-text-fill: white;" />
        <Button fx:id="btnDepartmentInfo" text="Department Info"
                style="-fx-background-color: #4a90e2; -fx-text-fill: white;" />
        <Button fx:id="btnAttendance" text="Attendance Tracker"
                style="-fx-background-color: #4a90e2; -fx-text-fill: white;" />
        <Button fx:id="btnRoleManagement" text="Role Management"
                style="-fx-background-color: #4a90e2; -fx-text-fill: white;" />
        <Button fx:id="btnExportReports" text="Export Reports"
                style="-fx-background-color: #4a90e2; -fx-text-fill: white;" />
        <Button fx:id="btnLogout" text="Logout"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
    </VBox>

</AnchorPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: linear-gradient(to bottom, #000000, #001f3f);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.addEmployeeController">

    <!-- Header -->
    <Label layoutX="250.0" layoutY="30.0" style="-fx-text-fill: #a9a9a9; -fx-font-size: 22px; -fx-font-weight: bold;" text="Add New Employee" />

    <!-- Form Fields -->
    <VBox layoutX="200.0" layoutY="80.0" prefWidth="300.0" spacing="15.0">
        <TextField fx:id="txtName" promptText="Full Name" style="-fx-background-color: #1a1a1a; -fx-text-fill: #d3d3d3; -fx-background-radius: 10;" />
        <TextField fx:id="txtEmail" promptText="Email" style="-fx-background-color: #1a1a1a; -fx-text-fill: #d3d3d3; -fx-background-radius: 10;" />
        <TextField fx:id="txtPhone" promptText="Phone Number" style="-fx-background-color: #1a1a1a; -fx-text-fill: #d3d3d3; -fx-background-radius: 10;" />
        <TextField fx:id="txtDepartment" promptText="Department" style="-fx-background-color: #1a1a1a; -fx-text-fill: #d3d3d3; -fx-background-radius: 10;" />
        <TextField fx:id="txtRole" promptText="Role" style="-fx-background-color: #1a1a1a; -fx-text-fill: #d3d3d3; -fx-background-radius: 10;" />
    </VBox>

    <!-- Action Buttons -->
    <HBox layoutX="250.0" layoutY="350.0" spacing="20.0">
        <Button fx:id="btnAdd" onAction="#btnAdd" style="-fx-background-color: #1a1a1a;                        -fx-text-fill: #d3d3d3;                        -fx-background-radius: 30;                        -fx-border-radius: 30;                        -fx-border-color: #a9a9a9;                        -fx-border-width: 1;" text="Add" />
        <Button fx:id="btnCancel" onAction="#btnCancel" style="-fx-background-color: #333333;                        -fx-text-fill: #d3d3d3;                        -fx-background-radius: 30;                        -fx-border-radius: 30;                        -fx-border-color: #a9a9a9;                        -fx-border-width: 1;" text="Cancel" />
    </HBox>

</AnchorPane>

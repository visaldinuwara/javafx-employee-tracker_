<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controller.updateEmployee"
            prefHeight="500.0" prefWidth="700.0"
            style="-fx-background-color: linear-gradient(to bottom, #000000, #001f3f);">

    <!-- Header -->
    <Label text="Update Employee Details"
           layoutX="230.0" layoutY="30.0"
           style="-fx-text-fill: #a9a9a9; -fx-font-size: 22px; -fx-font-weight: bold;" />

    <!-- Employee ID + Search -->
    <HBox layoutX="200.0" layoutY="80.0" spacing="10.0">
        <TextField fx:id="txtEmployeeId" promptText="Employee ID"
                   prefWidth="200.0"
                   style="-fx-background-color: #1a1a1a;
                          -fx-text-fill: #d3d3d3;
                          -fx-background-radius: 10;" />
        <Button fx:id="btnSearch" text="Search"
                style="-fx-background-color: #1a1a1a;
                       -fx-text-fill: #d3d3d3;
                       -fx-background-radius: 30;
                       -fx-border-radius: 30;
                       -fx-border-color: #a9a9a9;
                       -fx-border-width: 1;" />
    </HBox>

    <!-- Form Fields -->
    <VBox layoutX="200.0" layoutY="130.0" spacing="15.0" prefWidth="300.0">
        <TextField fx:id="txtName" promptText="Full Name"
                   style="-fx-background-color: #1a1a1a; -fx-text-fill: #d3d3d3; -fx-background-radius: 10;" />
        <TextField fx:id="txtEmail" promptText="Email"
                   style="-fx-background-color: #1a1a1a; -fx-text-fill: #d3d3d3; -fx-background-radius: 10;" />
        <TextField fx:id="txtPhone" promptText="Phone Number"
                   style="-fx-background-color: #1a1a1a; -fx-text-fill: #d3d3d3; -fx-background-radius: 10;" />
        <TextField fx:id="txtDepartment" promptText="Department"
                   style="-fx-background-color: #1a1a1a; -fx-text-fill: #d3d3d3; -fx-background-radius: 10;" />
        <TextField fx:id="txtRole" promptText="Role"
                   style="-fx-background-color: #1a1a1a; -fx-text-fill: #d3d3d3; -fx-background-radius: 10;" />
    </VBox>

    <!-- Action Buttons -->
    <HBox layoutX="250.0" layoutY="400.0" spacing="20.0">
        <Button fx:id="btnUpdate" text="Update"
                style="-fx-background-color: #1a1a1a;
                       -fx-text-fill: #d3d3d3;
                       -fx-background-radius: 30;
                       -fx-border-radius: 30;
                       -fx-border-color: #a9a9a9;
                       -fx-border-width: 1;" />
        <Button fx:id="btnCancel" text="Cancel"
                style="-fx-background-color: #333333;
                       -fx-text-fill: #d3d3d3;
                       -fx-background-radius: 30;
                       -fx-border-radius: 30;
                       -fx-border-color: #a9a9a9;
                       -fx-border-width: 1;" />
    </HBox>

</AnchorPane>
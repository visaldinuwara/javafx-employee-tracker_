<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controller.deleteEmployee"
            prefHeight="300.0" prefWidth="600.0"
            style="-fx-background-color: linear-gradient(to bottom, #000000, #001f3f);">

    <!-- Header -->
    <Label text="Delete Employee"
           layoutX="220.0" layoutY="30.0"
           style="-fx-text-fill: #a9a9a9; -fx-font-size: 22px; -fx-font-weight: bold;" />

    <!-- Employee ID + Search -->
    <HBox layoutX="150.0" layoutY="90.0" spacing="10.0">
        <TextField fx:id="txtEmployeeId" promptText="Employee ID"
                   prefWidth="200.0"
                   style="-fx-background-color: #1a1a1a;
                          -fx-text-fill: #d3d3d3;
                          -fx-background-radius: 10;" />
        <Button fx:id="btnSearch" text="Search"
                style="-fx-background-color: #1a1a1a;
                       -fx-text-fill: #d3d3d3;
                       -fx-background-radius: 30;
                       -fx-border-radius: 30;
                       -fx-border-color: #a9a9a9;
                       -fx-border-width: 1;" />
    </HBox>

    <!-- Name Field -->
    <VBox layoutX="150.0" layoutY="140.0" spacing="10.0" prefWidth="300.0">
        <TextField fx:id="txtName" promptText="Employee Name"
                   style="-fx-background-color: #1a1a1a;
                          -fx-text-fill: #d3d3d3;
                          -fx-background-radius: 10;" />
    </VBox>

    <!-- Action Buttons -->
    <HBox layoutX="200.0" layoutY="210.0" spacing="20.0">
        <Button fx:id="btnDelete" text="Delete"
                style="-fx-background-color: #1a1a1a;
                       -fx-text-fill: #d3d3d3;
                       -fx-background-radius: 30;
                       -fx-border-radius: 30;
                       -fx-border-color: #a9a9a9;
                       -fx-border-width: 1;" />
        <Button fx:id="btnCancel" text="Cancel"
                style="-fx-background-color: #333333;
                       -fx-text-fill: #d3d3d3;
                       -fx-background-radius: 30;
                       -fx-border-radius: 30;
                       -fx-border-color: #a9a9a9;
                       -fx-border-width: 1;" />
    </HBox>

</AnchorPane>
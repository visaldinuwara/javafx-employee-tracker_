<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.image.ImageView?>
<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #2b2b2b;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.logInController"> <!-- Dark background -->

    <!-- Anchor logo image above company name -->
    <ImageView layoutX="50.0" layoutY="100.0"
               fitHeight="150" fitWidth="200.0"
               pickOnBounds="true" preserveRatio="true">
        <image>
            <Image url="/Media/samsungLogo.png"/>
        </image>
    </ImageView>



    <!-- Login Form on the right side -->
    <VBox alignment="CENTER" layoutX="350.0" layoutY="100.0" spacing="15.0">
        <Label style="-fx-text-fill: white; -fx-font-size: 20px;" text="Login" />

        <TextField fx:id="txtUserName" promptText="Username" style="-fx-background-color: #3c3f41; -fx-text-fill: white;" />

        <PasswordField fx:id="passwordField" promptText="Password" style="-fx-background-color: #3c3f41; -fx-text-fill: white;" />

        <Button fx:id="btnLogIn" onAction="#btnLogIn" style="-fx-background-color: #4a90e2; -fx-text-fill: white;" text="Log In" />
    </VBox>

</AnchorPane>
